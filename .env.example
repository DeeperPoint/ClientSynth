# ClientSynth local configuration — copy to .env and fill in.
# docker-compose reads this file automatically for variable interpolation.
# Never commit .env (it is gitignored/dockerignored).

# --- Required ---------------------------------------------------------------
# Secret used to sign session JWTs. Any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# OpenRouter key for AI text generation (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# --- Optional ---------------------------------------------------------------
# Fal key for AI image generation; leave empty to get placeholder images.
FAL_KEY=

# AWS S3 for generated-file storage. Leave empty and keep MOCK_S3=true to
# store files locally in ./uploads instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
MOCK_S3=true

# Base URL of a Cosolvent instance for the "cosolvent" export format.
COSOLVENT_BASE_URL=

# Google Drive integration (optional)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
