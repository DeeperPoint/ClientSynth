      "id": "certs_by_headcount",
      "name": "Certifications follow headcount",
      "type": "conditional_enum",
      "sourceField": "headcount",
      "targetFields": [
        "certifications"
      ],
      "config": {
        "conditions": [
          {
            "when": {
              "gt": 500
            },
            "allow": [
              "AS9100D",
              "NADCAP",
              "ISO 9001:2015"
            ]
          },
          {
            "when": {
              "gt": 0
            },
            "allow": [
              "ISO 9001:2015"
            ]
          }
        ]
      },
      "description": "Only shops above 500 people hold the full aerospace stack.",
      "severity": "error",
      "source_page": "rules/certs.md"
    },
